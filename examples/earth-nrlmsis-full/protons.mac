# AtRIS simulation macro for protons
# Generated by atris-generate-macros.
#
# Commands are applied from top to bottom.
# /atris/ configures AtRIS inputs, scoring, and output.
# /run/ initializes Geant4, controls transport, and starts events.
# /gps/ configures Geant4's General Particle Source (GPS).

# AtRIS input and output files
# These AtRIS-specific settings must precede /run/initialize.
# Read the detector geometry from this GDML file.
/atris/geometryFile protons.gdml
# Read output energy-bin edges; GPS source sampling is configured below.
/atris/energyBinsFile protons.bins
# Use this filename stem for all simulation output.
/atris/outputStem protons

# Physics and output content
# Choose the Geant4 physics and the amount and format of saved data.
# Use this Geant4 reference physics list for particle transport.
/atris/physicsList FTFP_BERT_HP
# Save aggregate response histograms only.
/atris/outputMode response
# Write analysis data using Geant4's csv backend.
/atris/outputFormat csv

# Diagnostic histogram resolution
# These settings affect source diagnostic histograms, not sampling.
# Divide source-direction azimuth into 120 histogram bins.
/atris/directionHistogram/azimuthBins 120
# Divide source-direction cos(polar angle) into 60 histogram bins.
/atris/directionHistogram/cosineBins 60
# Divide source-position azimuth into 120 histogram bins.
/atris/positionHistogram/azimuthBins 120
# Divide source-position cos(polar angle) into 60 histogram bins.
/atris/positionHistogram/cosineBins 60

# Phantom response scoring
# Each phantom block selects a name and registers one or more responses.
# accumulation chooses the calculation: coefficient uses the table
# value directly; energy multiplies it by crossing energy in eV;
# radiation-weighted-energy also applies the radiation weight.
# name labels the output, tableFile supplies coefficients, and add
# registers the response and clears those three response properties.

# Phantom: ramona_zero_0.060MeV_detA
/atris/phantom/name ramona_zero_0.060MeV_detA

# Response: absorbed dose (name: dos)
/atris/phantom/response/accumulation energy
/atris/phantom/response/name dos
/atris/phantom/response/tableFile ramona_zero_0.060MeV_detA_response.txt
/atris/phantom/response/add

# Response: equivalent dose (name: equi)
/atris/phantom/response/accumulation radiation-weighted-energy
/atris/phantom/response/name equi
/atris/phantom/response/tableFile ramona_zero_0.060MeV_detA_response.txt
/atris/phantom/response/add

# Response: counting response (name: rates)
/atris/phantom/response/accumulation coefficient
/atris/phantom/response/name rates
/atris/phantom/response/tableFile ramona_zero_0.060MeV_detA_counting.txt
/atris/phantom/response/add

# Phantom: icru_zero_0.000MeV_detAB
/atris/phantom/name icru_zero_0.000MeV_detAB

# Response: absorbed dose (name: dos)
/atris/phantom/response/accumulation energy
/atris/phantom/response/name dos
/atris/phantom/response/tableFile icru_zero_0.000MeV_detAB_response.txt
/atris/phantom/response/add

# Response: equivalent dose (name: equi)
/atris/phantom/response/accumulation radiation-weighted-energy
/atris/phantom/response/name equi
/atris/phantom/response/tableFile icru_zero_0.000MeV_detAB_response.txt
/atris/phantom/response/add

# Response: counting response (name: rates)
/atris/phantom/response/accumulation coefficient
/atris/phantom/response/name rates
/atris/phantom/response/tableFile icru_zero_0.000MeV_detAB_counting.txt
/atris/phantom/response/add

# Reproducibility
# Geant4 requires two positive seeds for this random-number stream.
# Set the two random seeds before initialization.
/atris/randomSeeds 436888 768307

# Geant4 initialization and transport controls
# Initialization builds the configured geometry and physics processes.
# Initialize Geant4 after all /atris/ configuration is complete.
/run/initialize
# Print Geant4 run-manager progress at verbosity level 2.
/run/verbose 2
# Set the global secondary-production range cut; this is not an energy.
/run/setCut 100. m
# Print the resulting material-dependent production cuts.
/run/particle/dumpCutValues

# GPS primary particle and energy
# The General Particle Source creates the primary particle for each event.
# Generate this particle species.
/gps/particle proton
# Sample kinetic energy from a power-law distribution.
/gps/ene/type Pow
# Set the minimum primary kinetic energy.
/gps/ene/min 1.000000000 MeV
# Set the maximum primary kinetic energy.
/gps/ene/max 1000000.000000000 MeV
# Use an E^-1 power law, which is uniform in log kinetic energy.
/gps/ene/alpha -1

# GPS primary position and direction
# Primaries start on a sphere and travel inward through the model.
# Sample positions on a surface rather than inside a volume.
/gps/pos/type Surface
# Use a spherical source surface.
/gps/pos/shape Sphere
# Center the source sphere on the planet model.
/gps/pos/centre 0 0 0 m
# Place the source 1 m beyond the atmosphere (the penultimate PSF layer).
/gps/pos/radius 6472.001 km
# Use cosine-law incidence about the inward surface normal.
/gps/ang/type cos
# Set the minimum polar angle from the inward normal.
/gps/ang/mintheta 0 deg
# Limit directions to the inward hemisphere.
/gps/ang/maxtheta 90 deg
# Generate one primary particle per Geant4 event.
/gps/number 1

# Run events
# This final command starts particle transport.
# Process 363000 events with the configuration above.
/run/beamOn 363000

# End of AtRIS simulation macro.
