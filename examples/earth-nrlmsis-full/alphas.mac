# AtRIS simulation macro for alphas
# Generated by atris-generate-macros.

# Input and output files
/atris/geometryFile alphas.gdml
/atris/energyBinsFile alphas.bins
/atris/outputFile alphas
/atris/phantom/name ramona_zero_0.060MeV_detA
/atris/phantom/response/type energy
/atris/phantom/response/name dos
/atris/phantom/response/file ramona_zero_0.060MeV_detA_response.txt
/atris/phantom/response/add
/atris/phantom/response/type radiation-weighted-energy
/atris/phantom/response/name equi
/atris/phantom/response/file ramona_zero_0.060MeV_detA_response.txt
/atris/phantom/response/add
/atris/phantom/response/type coefficient
/atris/phantom/response/name rates
/atris/phantom/response/file ramona_zero_0.060MeV_detA_counting.txt
/atris/phantom/response/add
/atris/phantom/name icru_zero_0.000MeV_detAB
/atris/phantom/response/type energy
/atris/phantom/response/name dos
/atris/phantom/response/file icru_zero_0.000MeV_detAB_response.txt
/atris/phantom/response/add
/atris/phantom/response/type radiation-weighted-energy
/atris/phantom/response/name equi
/atris/phantom/response/file icru_zero_0.000MeV_detAB_response.txt
/atris/phantom/response/add
/atris/phantom/response/type coefficient
/atris/phantom/response/name rates
/atris/phantom/response/file icru_zero_0.000MeV_detAB_counting.txt
/atris/phantom/response/add

# Physics and analysis configuration
/atris/physicsList FTFP_BERT_HP
/atris/outputMode response
/atris/outputFormat csv
/atris/directionHistogram/azimuthBins 120
/atris/directionHistogram/cosineBins 60
/atris/positionHistogram/azimuthBins 120
/atris/positionHistogram/cosineBins 60
/atris/randomSeeds 10694 860046

# Initialize Geant4 after all pre-initialization settings
/run/initialize
/run/verbose 2

# Primary particle and energy distribution
/gps/particle alpha
# E^-1 gives uniform sampling in log kinetic energy.
/gps/ene/type Pow
/gps/ene/min 4.000000000 MeV
/gps/ene/max 4000000.000000000 MeV
/gps/ene/alpha -1

# Source position and direction
/gps/pos/type Surface
/gps/pos/shape Sphere
/gps/pos/centre 0 0 0 m
/gps/pos/radius 6472.001 km
/gps/ang/type cos
/gps/ang/mintheta 0 deg
/gps/ang/maxtheta 90 deg
/gps/number 1

# Transport and event count
/run/setCut 100. m
/run/particle/dumpCutValues
/run/beamOn 239580
